{
  "pluginAlias": "Panamax43xx",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Panamax M4315-PRO / M4320-PRO Power Conditioner Plugin for Homebridge",
  "footerDisplay": "Control multiple Panamax M4315-PRO and M4320-PRO units over local TCP / Telnet. All configured units are published together under 1 Child Bridge when child bridging is enabled.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Platform Name",
        "type": "string",
        "default": "Panamax 43xx",
        "description": "The name for this platform instance in Homebridge."
      },
      "platform": {
        "title": "Platform Identifier",
        "type": "string",
        "default": "Panamax43xx"
      },
      "_bridge": {
        "type": "object",
        "title": "Child Bridge",
        "description": "Optional Homebridge Child Bridge settings (managed via Bridge Settings in Homebridge UI).",
        "properties": {
          "username": {
            "type": "string"
          },
          "port": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "devices": {
        "title": "Panamax Units",
        "type": "array",
        "items": {
          "title": "Panamax Unit",
          "type": "object",
          "properties": {
            "name": {
              "title": "Device Name",
              "type": "string",
              "placeholder": "e.g., AV Rack 4320, Living Room 4315",
              "description": "A unique, identifiable name for this Panamax hardware unit."
            },
            "id": {
              "title": "Unique Identifier (Optional)",
              "type": "string",
              "placeholder": "e.g., rack-panamax-01",
              "description": "Optional unique ID to maintain persistent HomeKit pairing if IP or name changes."
            },
            "host": {
              "title": "IP Address / Hostname",
              "type": "string",
              "placeholder": "192.168.1.50",
              "description": "IPv4 address (e.g. 192.168.1.50) or valid hostname of the Panamax BlueBOLT card.",
              "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|(([a-zA-Z0-9]|[a-zA-Z0-9][a-zA-Z0-9\\-]*[a-zA-Z0-9])\\.)*([A-Za-z]|[A-Za-z][A-Za-z0-9\\-]*[A-Za-z0-9]))$",
              "required": true
            },
            "port": {
              "title": "TCP / Telnet Port",
              "type": "integer",
              "default": 23,
              "description": "Default is 23."
            },
            "pollInterval": {
              "title": "Polling Interval (seconds)",
              "type": "integer",
              "default": 10,
              "description": "How often to poll outlet status to keep Apple Home in sync. Default is 10 seconds."
            },
            "delay": {
              "title": "Outlet Delay (seconds)",
              "type": "integer",
              "default": 30,
              "description": "Delay in seconds per outlet to accommodate hardware power sequencing and relay switching before verifying status. Default is 30 seconds."
            },
            "accessoryMode": {
              "title": "HomeKit Accessory Mode",
              "type": "string",
              "default": "device",
              "oneOf": [
                {
                  "title": "Unified Device (Recommended: 1 accessory tile containing outlets)",
                  "enum": [
                    "device"
                  ]
                },
                {
                  "title": "Individual Accessories (Separate accessory tile per outlet)",
                  "enum": [
                    "individual"
                  ]
                }
              ],
              "description": "Unified Device mode presents 1 clean physical accessory in Apple Home and Homebridge. In Apple Home, you can choose to view them as a single tile or separate tiles."
            },
            "outletControlMode": {
              "title": "Outlets & Master Switch Mode",
              "type": "string",
              "default": "outletsAndMaster",
              "oneOf": [
                {
                  "title": "Individual Outlets (1\u20138) + Master Switch",
                  "enum": [
                    "outletsAndMaster"
                  ]
                },
                {
                  "title": "Individual Outlets (1\u20138) Only",
                  "enum": [
                    "outletsOnly"
                  ]
                },
                {
                  "title": "Master Switch Only",
                  "enum": [
                    "masterOnly"
                  ]
                }
              ],
              "description": "Choose whether to expose all 8 individual outlets and a Master All-Outlets switch, only the 8 individual outlets, or only the Master switch."
            },
            "enableRebootButtons": {
              "title": "Expose Reboot Buttons",
              "type": "boolean",
              "default": false,
              "description": "Adds momentary switches for triggering Panamax Reboot 1 and Reboot 2 sequences."
            },
            "outlet1": {
              "title": "Outlet 1",
              "type": "object",
              "condition": {
                "functionBody": "return !model.devices || !model.devices[arrayIndices[0]] || model.devices[arrayIndices[0]].outletControlMode !== 'masterOnly';"
              },
              "properties": {
                "name": {
                  "title": "Outlet 1 Name",
                  "type": "string",
                  "default": "Outlet 1",
                  "placeholder": "e.g., AV Receiver"
                },
                "accessoryType": {
                  "title": "HomeKit Service Type",
                  "type": "string",
                  "default": "Outlet",
                  "oneOf": [
                    {
                      "title": "Outlet",
                      "enum": [
                        "Outlet"
                      ]
                    },
                    {
                      "title": "Switch",
                      "enum": [
                        "Switch"
                      ]
                    }
                  ]
                }
              }
            },
            "outlet2": {
              "title": "Outlet 2",
              "type": "object",
              "condition": {
                "functionBody": "return !model.devices || !model.devices[arrayIndices[0]] || model.devices[arrayIndices[0]].outletControlMode !== 'masterOnly';"
              },
              "properties": {
